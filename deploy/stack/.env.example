# Copy to .env next to this file and edit locally.
# .env is gitignored.

# Public HTTP entry (nginx). Loopback by default.
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# Official llama.cpp server image.
# CUDA 13 (current NVIDIA 61x userspace): server-cuda13
# CUDA 12: ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13

# Open WebUI
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

# Host directory with GGUF files. Relative paths are resolved from deploy/stack/.
# Vision: one subdirectory per model, mmproj*.gguf next to the weights.
MODELS_DIR=./models

# Shared bearer token for /v1 and for Open WebUI → llama-server
LLAMA_API_KEY=sk-local

# Router / GPU defaults (16 GB class cards: keep MODELS_MAX=1)
# auto: llama.cpp offloads what fits; 99 fails when the desktop already holds VRAM
LLAMA_N_GPU_LAYERS=auto
LLAMA_FIT=on
# one chat/agent at a time; auto parallel=4 wastes KV on 16 GB
LLAMA_N_PARALLEL=1
# 16k with q8 KV: OpenCode system+tools already eat ~8k
LLAMA_CTX_SIZE=16384
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_N_PREDICT=4096
LLAMA_MODELS_MAX=1
# Qwen3.8 default thinking is heavy; low keeps tool loops usable
LLAMA_REASONING_EFFORT=low

# Stable Open WebUI cookie signing (replace on any shared host)
WEBUI_SECRET_KEY=change-me-local
